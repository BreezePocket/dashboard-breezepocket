VITE_SOLANA_RPC=https://api.devnet.solana.com
VITE_SOLANA_WS=wss://api.devnet.solana.com/
# PAYtience backend REST API: https://api.paytience.app in production, http://localhost:8080 for a local backend.
# Leave empty to try http://localhost:8080, then a local desk on http://localhost:8787.
VITE_API_URL=
# Legacy name for VITE_API_URL (it may also point at a single desk); read only when VITE_API_URL is empty.
# VITE_MM_URL=
# Privy app for login and wallets. Public, and the site already defaults to the PAYtience app; set it only to use another.
# Never put the Privy app SECRET here: it is for servers, and everything in a VITE_ variable ships to the browser.
# VITE_PRIVY_APP_ID=
# Optional Privy app client for this site, when its settings differ from the app's defaults.
# VITE_PRIVY_CLIENT_ID=
